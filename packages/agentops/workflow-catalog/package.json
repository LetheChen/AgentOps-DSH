{
  "name": "@agentops/dsh-workflow-catalog",
  "description": "Workflow definition catalogue for AgentOps: list, read, validate, compile, and compare-and-swap save.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@agentops/dsh-contracts": "workspace:*",
    "@agentops/dsh-workflow-compiler": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
