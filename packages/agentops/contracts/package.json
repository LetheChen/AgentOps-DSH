{
  "name": "@agentops/dsh-contracts",
  "description": "AgentOps migration contracts: Agent and workflow definitions, validation, and the single edge-derivation rule.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "@types/js-yaml": "^4.0.9"
  }
}
