{
  "main": "lib/types/index.js",
  "type": "module",
  "types": "lib/types/index.d.ts",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./tools": {
      "default": "./lib/types/tools-plugin.js",
      "types": "./lib/types/tools-plugin.d.ts"
    }
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-connection": "workspace:*"
  },
  "name": "@agentops/dsh-log-collection",
  "description": "AgentOps log collection domain: SSH-backed task registry, task ACL, safe local storage keys and revisioned lifecycle.",
  "license": "MIT",
  "version": "0.1.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/node": "^24.5.2",
    "@types/ssh2": "^1.15.6",
    "tsdown": "^0.20.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-client-connection": "workspace:*"
  },
  "dependencies": {
    "@agentops/dsh-capability": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "ssh2": "^1.17.0"
  }
}
